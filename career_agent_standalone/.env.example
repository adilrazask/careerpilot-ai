# Public web search provider. Required for scheduled vacancy discovery.
TAVILY_API_KEY=

# Optional local AI model for truthful resume tailoring.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# SMTP email configuration. Use an app password/OAuth-compatible approach; never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Required for unattended application emails; use your real signature details.
CAREER_FULL_NAME=
CAREER_PHONE=
CAREER_EMAIL=
