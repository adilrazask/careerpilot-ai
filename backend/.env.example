# ==========================================
# CareerPilot AI Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite default for local development, PostgreSQL for deployment)
DATABASE_URL=sqlite:///./data/careerpilot.db

# Authentication / Security
SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Integrations
# 1. Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 2. Optional Hosted AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Search & Enrichment Providers
TAVILY_API_KEY=
SERPER_API_KEY=

# Outbound Email Configuration (SMTP / Gmail / Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Inbound Email Monitoring (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
INBOUND_POLL_INTERVAL_MINUTES=15

# Owner Personal Information (Defaults for applications)
CAREER_FULL_NAME=
CAREER_PHONE=
CAREER_EMAIL=
CAREER_LOCATION=Hyderabad, India
CAREER_LINKEDIN=

# Automation Default Policies
AUTONOMOUS_ENABLED=0
MAX_APPLICATIONS_PER_DAY=5
MAX_APPLICATIONS_PER_COMPANY_PER_MONTH=2
MIN_MATCH_SCORE=65
MAX_EMAILS_PER_HOUR=10
SEARCH_INTERVAL_MINUTES=240
FOLLOW_UP_FIRST_DAYS=5
FOLLOW_UP_SECOND_DAYS=7
